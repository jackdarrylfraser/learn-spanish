---
import "../styles/global.css";
import "../styles/reader.scss";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Read Spanish stories and learn as you go." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
