---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getStories } from "../lib/stories";

const stories = await getStories();
---

<BaseLayout title="Spanish Reading">
  <section class="story-index" id="stories" aria-labelledby="stories-heading">
    <header class="index-header">
      <h1 id="stories-heading">Recent Stories</h1>
      <p>{stories.length} {stories.length === 1 ? "story" : "stories"} to read</p>
    </header>

    {stories.length > 0 ? (
      <ul class="story-list">
        {stories.map(({ slug, story }) => (
          <li>
            <article class="story-entry">
              <h2>
                <a href={`/stories/${slug}/`}>{story.title}</a>
              </h2>
              <p>{story.cefr} · Spanish reading</p>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">Stories are on their way. Check back soon.</p>
    )}
  </section>
</BaseLayout>
