---
import GlossGroup from "../../components/GlossGroup.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getStories } from "../../lib/stories";

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map(({ slug, story }) => ({
    params: { slug },
    props: { story },
  }));
}

const { story } = Astro.props;
---

<BaseLayout title={`${story.title} | Spanish Reading`} description={`Read ${story.title}, a ${story.cefr} Spanish story.`}>
  <article class="reader">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/#stories">All stories</a>
      <span aria-hidden="true">/</span>
      <span>{story.title}</span>
    </nav>

    <header class="reader-header">
      <h1>{story.title}</h1>
      <p>{story.cefr} · Select a phrase to see its English translation.</p>
    </header>

    <section class="reader-content" aria-label="Spanish story">
      <p class="story-text" lang="es">
        {story.groups.map((group, index) => (
          <>
            {index > 0 && " "}
            <GlossGroup spanish={group.spanish} english={group.english} index={index} />
          </>
        ))}
      </p>
      <div class="translation-tooltip" id="translation-tooltip" role="status" aria-live="polite" hidden></div>
    </section>
  </article>

  <script>
    const tooltip = document.querySelector<HTMLDivElement>("#translation-tooltip");
    const groups = document.querySelectorAll<HTMLButtonElement>(".gloss-group");
    let activeGroup: HTMLButtonElement | null = null;

    if (!tooltip) {
      throw new Error("The translation tooltip is missing from the story reader.");
    }

    const dismissTranslation = () => {
      if (!activeGroup) return;
      activeGroup.setAttribute("aria-pressed", "false");
      activeGroup = null;
      tooltip.hidden = true;
      tooltip.classList.remove("is-below");
    };

    groups.forEach((group) => {
      group.addEventListener("click", () => {
        if (activeGroup === group) {
          dismissTranslation();
          return;
        }

        if (activeGroup) activeGroup.setAttribute("aria-pressed", "false");

        const english = group.dataset.english;
        if (!english) {
          throw new Error("A story phrase is missing its English translation.");
        }

        group.setAttribute("aria-pressed", "true");
        activeGroup = group;
        tooltip.textContent = english;
        tooltip.hidden = false;

        const phraseRect = group.getBoundingClientRect();
        const tooltipRect = tooltip.getBoundingClientRect();
        const showBelow = phraseRect.top < tooltipRect.height + 16;
        const centerX = phraseRect.left + phraseRect.width / 2;
        const minX = tooltipRect.width / 2 + 12;
        const maxX = window.innerWidth - minX;

        tooltip.style.left = `${Math.max(minX, Math.min(centerX, maxX))}px`;
        tooltip.style.top = `${showBelow ? phraseRect.bottom + 8 : phraseRect.top - 8}px`;
        tooltip.classList.toggle("is-below", showBelow);
      });
    });

    document.addEventListener("click", (event) => {
      if (activeGroup && !activeGroup.contains(event.target as Node)) {
        dismissTranslation();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") dismissTranslation();
    });

    window.addEventListener("scroll", dismissTranslation, { passive: true });
    window.addEventListener("resize", dismissTranslation);
  </script>
</BaseLayout>
